# ─────────────────────────────────────────────────────
# TACSFON Merch Store — Environment Variables Template
# Copy to .env.local for local development
# Add all values to Vercel and Render dashboards for production
# ─────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # NEVER prefix with NEXT_PUBLIC_ — backend only

# Google OAuth (configured in Supabase dashboard, not directly used here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot (Phase 10)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID_1=
TELEGRAM_ADMIN_CHAT_ID_2=

# App
NEXT_PUBLIC_APP_URL=            # e.g. https://tacsfon-merch.vercel.app
NODE_ENV=development             # development | production

# Bank details (served to frontend via API — never hardcoded client-side)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
